+/// Prefilter for a user regex: the literal prefixes every match must start
+/// with (regex-syntax extraction, case folding included), as an alternation
+/// searched over raw block bytes. `None` when no useful literal set exists.
+fn regex_prefilter(pattern: &str, ci: bool) -> Option<Regex> {
+    use regex_syntax::hir::literal::{ExtractKind, Extractor};
+    let hir = regex_syntax::ParserBuilder::new()
+        .case_insensitive(ci)
+        .build()
+        .parse(pattern)
+        .ok()?;
+    let mut seq = Extractor::new()
+        .kind(ExtractKind::Prefix)
+        .limit_total(64)
+        .extract(&hir);
+    seq.optimize_for_prefix_by_preference();
+    let lits = seq.literals()?;
+    if lits.is_empty() || lits.len() > 64 {
+        return None;
+    }
+    let mut alts = Vec::with_capacity(lits.len());
+    for l in lits {
+        let b = l.as_bytes();
+        // Too short to be selective, or spelled differently in the file.
+        if b.len() < 2 || b.iter().any(|c| matches!(c, b'"' | b'\n' | b'\r')) {
+            return None;
+        }
+        alts.push(regex::escape(std::str::from_utf8(b).ok()?));
+    }
+    RegexBuilder::new(&alts.join("|")).unicode(true).build().ok()
+}
