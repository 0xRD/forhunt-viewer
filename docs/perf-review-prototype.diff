+/// End of the field that starts at `start` (index of its delimiter, or
+/// `row.len()`) and whether it is quoted. Same semantics as the state
+/// machine, but quoted fields are skipped with `memchr` on the quote byte
+/// only (delimiters inside quotes are data) and other fields with `memchr`
+/// on the delimiter.
+#[inline]
+fn field_end(t: &Tables, row: &[u8], start: usize) -> (usize, bool) {
+    let n = row.len();
+    let q = t.quote;
+    if q != t.delim && start < n && row[start] == q {
+        let mut p = start + 1;
+        loop {
+            match memchr::memchr(q, &row[p..]) {
+                None => return (n, true),
+                Some(k) => {
+                    let a = p + k;
+                    if row.get(a + 1) == Some(&q) {
+                        p = a + 2;
+                    } else {
+                        p = a + 1;
+                        break;
+                    }
+                }
+            }
+        }
+        // Closing quote seen: the field ends at the next delimiter, text in
+        // between is literal.
+        let end = if p >= n || row[p] == t.delim {
+            p.min(n)
+        } else {
+            memchr::memchr(t.delim, &row[p..]).map_or(n, |k| p + k)
+        };
+        (end, true)
+    } else {
+        let end = memchr::memchr(t.delim, &row[start.min(n)..]).map_or(n, |k| start + k);
+        (end, false)
+    }
